# 复制为 .env 后填写真实值（切勿提交到 git）
# 通义千问 API Key，从 https://bailian.console.aliyun.com/ 获取
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 对话模型。注意：qwen3-max 在部分账号下会返回 Model not exist，此时用 qwen-max / qwen-plus
CHAT_MODEL_NAME=qwen-max
EMBEDDING_MODEL_NAME=text-embedding-v4

# 检索条数：穿搭问题需要同时命中"身材+配色+场景"，建议 4
TOP_K=4

# 数据目录：向量库 / md5.txt / chat_history / kb_state.json 的存放位置
# 本地不填时默认取本文件所在目录；Docker 中由 Dockerfile 固定为 /app/data
# RAG_DATA_DIR=./data

# 知识库自动构建（启动时在后台跑，不阻塞服务）
KB_AUTO_BOOTSTRAP=true

# 联网采集：只在启动时一次性扩充知识库，用户提问时不联网
WEB_SEARCH_ENABLED=true
# bing（免密钥，解析搜索结果页） / bocha（博查 API，需 key） / none（只用本地语料）
WEB_SEARCH_PROVIDER=bing
WEB_SEARCH_API_KEY=
# 采集缓存有效期（天）：未过期则重启时跳过联网
WEB_REFRESH_DAYS=7
# 单次采集时间上限（秒）与抓取页面上限
WEB_TIMEOUT_SECONDS=120
WEB_MAX_PAGES=12

# 日志级别：DEBUG / INFO / WARNING
LOG_LEVEL=INFO
