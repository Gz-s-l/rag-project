# =====================================================================
# docker compose 环境变量模板
# 使用：复制为 .env（同目录），填入真实值后执行 docker compose up -d --build
# 注意：.env 含密钥，不要提交到 Git
# =====================================================================

# --- 必填 ---
# 阿里云百炼 DashScope API Key（https://bailian.console.aliyun.com 获取）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MySQL root 密码（首次初始化数据卷时生效，改密码后需删卷重建）
MYSQL_ROOT_PASSWORD=123456

# --- 选填（不填用默认值）---
# 前端对外端口（IP 直连时访问 http://服务器IP:WEB_PORT）
WEB_PORT=8081

# 域名（启用 HTTPS 时必填）：只写域名，不要带 https:// 和结尾斜杠
# 例：DOMAIN=chat.example.com
# 前提：域名 A 记录已指向服务器公网 IP，且安全组放行 80/443
# 启用：docker compose --profile https up -d
DOMAIN=

# 模型（当前账号 qwen3-max 不可用，默认 qwen-max）
CHAT_MODEL_NAME=qwen-max
EMBEDDING_MODEL_NAME=text-embedding-v4
TOP_K=4

# 知识库自动构建：启动时补齐 corpus 语料 + 过期则联网采集
KB_AUTO_BOOTSTRAP=true
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_API_KEY=

# 国内构建加速：pip 镜像（留空用官方源）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
