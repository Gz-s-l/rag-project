# =====================================================================
# Caddy 反向代理配置：对外 HTTPS 入口
#
# 作用：终结 TLS（自动向 Let's Encrypt 申请并续期证书），再转发给 frontend(nginx)。
# 启用前提：
#   1) 域名 A 记录已指向本机公网 IP（解析生效后再启动，否则证书申请会失败）；
#   2) 服务器安全组/防火墙放行 80 和 443；
#   3) .env 里设置了 DOMAIN=你的域名。
# 启动：docker compose --profile https up -d
#
# 为什么用它而不是 nginx + certbot：
#   证书申请、续期、HTTP→HTTPS 跳转、OCSP 装订全自动，配置只有几行，
#   不需要额外写 cron 跑 certbot renew。
# =====================================================================

# {$DOMAIN} 由 docker-compose 从 .env 注入。
# 未设置时 Caddy 会启动失败并提示，属于"配置漏了"而不是"跑挂了"。
{$DOMAIN} {

	# -------------------------------------------------------------
	# SSE 流式接口：绝对不能压缩、不能缓冲
	#
	# 单独拎出来处理，是为了绕开下面的 encode 指令：
	# 一旦 gzip 对 text/event-stream 生效，代理层会攒够一个压缩块才吐，
	# 前端就会看到"卡住几秒然后整段蹦出来"，逐字效果全毁。
	# flush_interval -1 = 每收到上游一片数据立即下发。
	# -------------------------------------------------------------
	handle /api/* {
		reverse_proxy frontend:80 {
			flush_interval -1
		}
	}

	# -------------------------------------------------------------
	# 静态资源：压缩传输（JS/CSS 走 gzip，首屏更快）
	# -------------------------------------------------------------
	handle {
		encode zstd gzip
		reverse_proxy frontend:80
	}

	# -------------------------------------------------------------
	# 安全响应头
	# HSTS 会让浏览器后续强制走 https，确认证书稳定后再放开（已默认开启，
	# 若还在调试阶段且反复换域名，可先注释掉这一行）。
	# -------------------------------------------------------------
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# 访问日志输出到容器 stdout，用 docker compose logs -f caddy 查看
	log {
		output stdout
		format console
	}
}
