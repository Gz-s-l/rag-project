# Python 编译文件
__pycache__/
*.py[cod]
*.pyd
.env

# 虚拟环境（注意：本项目历史上出现过 `激活环境venv`、`venv#` 这类畸形目录名，
# 后两条通配规则专门兜住它们，避免几百个第三方包被提交进仓库）
venv/
env/
.venv/
*venv*/
*venv#

# IDE
.idea/
.vscode/
*.iml

# 你的 RAG 项目专属（必须忽略）
chat_history/
data/
*.db
*.sqlite

# 系统文件
.DS_Store
Thumbs.db

# AI 助手的工作记录（不属于项目代码）
.workbuddy/

# 知识库去重记录（与向量库同生共死，随部署重建，不入库）
md5.txt

# 依赖与构建产物（服务器上重新构建，不要提交）
node_modules/
dist/
target/
tools/

